{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run export:web",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/*.mjs": {
      "includeFiles": "backend/tiger-ca.crt",
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
