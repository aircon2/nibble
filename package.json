{
  "name": "nibble-workspace",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "web": "npm run web --workspace frontend",
    "hints": "npm run start --workspace backend",
    "typecheck": "npm run typecheck --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "export:web": "npm exec --workspace frontend -- expo export --platform web"
  }
}
